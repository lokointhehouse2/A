APP_ENV=development
APP_PORT=42005
APP_BASE_URL=http://127.0.0.1:42005

DB_HOST=127.0.0.1
# 3306 is commonly taken by a local MySQL; the bundled docker-compose MariaDB listens on 3308.
DB_PORT=3308
DB_NAME=futurepath
DB_USER=futurepath_app
DB_PASSWORD=CHANGE_ME
DB_SSL=false
# Used only by docker-compose for the local development container.
DB_ROOT_PASSWORD=CHANGE_ME_ROOT
# Apply pending db/migrations/NNN_*.sql on application start (always on when APP_ENV=development).
DB_AUTO_MIGRATE=true

# Public data connectors
COLLEGE_SCORECARD_API_KEY=
CENSUS_API_KEY=
ONET_USERNAME=
ONET_PASSWORD=
# BLS blocks automated downloads unless the User-Agent carries a contact email (BLS usage policy).
BLS_CONTACT_EMAIL=
IMPORT_STORAGE_PATH=./storage/imports
# development: import any downloaded files in storage/imports/raw automatically on first start
IMPORT_AUTO_BOOTSTRAP=true
# development: when a dataset has never been imported and no file is present, download it from the official source
IMPORT_AUTO_DOWNLOAD=true

APP_SECRET=REPLACE_WITH_RANDOM_SECRET
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Public JSON API rate limit (requests per minute per client IP)
API_RATE_LIMIT_PER_MINUTE=120

# Windows only: make the Lucee JVM trust the Windows certificate store
# (needed when antivirus/proxy software intercepts HTTPS). scripts/setup.ps1 sets this on Windows.
JAVA_TRUSTSTORE_ARGS=
